# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Get from: Supabase dashboard → Settings → Database → Connection string (URI mode)
# Use the "Transaction" pooler URL for serverless/Render (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations (bypasses pooler)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-access-token-secret-min-64-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-min-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Get from: Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=story-data
R2_PUBLIC_URL=https://pub-xxxx.r2.dev   # or your custom domain

# ── Email (for password recovery) ────────────────────────────────────────────
# HTTPS Api: Resend.com (free 3000 emails/mo)
RESEND_API_KEY=your-resend-api-key
RESEND_EMAIL_FROM=noreply@yourdomain.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Frontend URL (for email links) ────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
